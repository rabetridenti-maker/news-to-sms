# =============================================================================
# news-to-sms configuration
# Copy to `.env` and fill in. Every value has a safe default so `dry_run` works
# out of the box with zero credentials.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# `console` prints the messages instead of sending (safe default).
# `webhook`  POSTs JSON to a generic HTTP SMS gateway (校讯通 plug-in point).
# `aliyun`   uses Aliyun SMS (Dysmsapi) with an approved signature+template.
# `smsbao`   uses 短信宝 (username + ApiKey) with direct content sending.
SMS_PROVIDER=console
DRY_RUN=true

# ---- News source -------------------------------------------------------------
# "rss" (RSS/Atom feed) or "json" (arbitrary JSON endpoint).
NEWS_SOURCE_TYPE=rss
# Example public feed; swap for your real source. For JSON sources this is the URL.
NEWS_URL=https://example.com/feed.xml
# Keep only items published within this many hours (0 = today's calendar day).
NEWS_WINDOW_HOURS=24
# Hard cap on how many items are processed per run.
NEWS_MAX_ITEMS=10

# ---- SMS ---------------------------------------------------------------------
# The fixed sender number / signature that recipients see. This is the "从固定号码发出" bit.
SMS_SENDER=10690000
# Comma-separated recipient phone numbers (校讯通 subscribers).
SMS_RECIPIENTS=13800000000
# Per-message character cap ("每条只能接收200字").
SMS_MAX_LENGTH=200

# ---- Generic HTTP gateway (SMS_PROVIDER=webhook) -------------------------------
SMS_WEBHOOK_URL=
# Optional bearer token sent in the Authorization header.
SMS_WEBHOOK_TOKEN=

# ---- Aliyun SMS (SMS_PROVIDER=aliyun) ------------------------------------------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# The approved signature name and template (must contain a `${content}` variable).
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_CODE=

# ---- 短信宝 SMS (SMS_PROVIDER=smsbao) -------------------------------------------
SMSBAO_USERNAME=
# ApiKey (from backend/customer service) or the MD5 of your login password.
SMSBAO_APIKEY=

# ---- AI rewrite (optional) -------------------------------------------------------
# Set AI_API_KEY to enable rewriting each article with an OpenAI-compatible LLM
# before sending. Default model is the free 智谱 GLM-4-Flash.
AI_API_KEY=
AI_MODEL=glm-4-flash
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- Storage -------------------------------------------------------------------
STATE_PATH=state/state.json
ARCHIVE_DIR=archive
